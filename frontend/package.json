{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs --cache",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.mjs --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest --project unit",
    "test:component": "vitest --project component",
    "prepare": "cd .. && husky install frontend"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^6.0.0",
    "@mui/material": "^6.0.0",
    "@mui/material-nextjs": "^7.3.9",
    "@mui/system": "^6.0.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "eslint-plugin-import": "^2.29",
    "eslint-plugin-react-hooks": "^5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^16.4.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
